# ───────────────────────────────────────────────────────────────────────────
#  DEVELOPMENT ENV TEMPLATE  (placeholders only — DO NOT put real secrets here)
#  Copy to `.env` (gitignored) and fill real values, OR run with APP_ENV=development.
#  settings.py loads `.env.${APP_ENV}` first, then `.env`.
# ───────────────────────────────────────────────────────────────────────────

# --- Runtime ---
APP_ENV=development
# Process clock for all market-hours logic. Keep IST for Indian markets.
TZ=Asia/Kolkata

# --- Angel One (broker) ---
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_login_pin
ANGEL_TOTP_SECRET=your_totp_base32_secret

# --- Telegram (alerts) ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- LLM Provider: "anthropic" | "openai" | "groq" | "ollama" | "gemini" ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# API keys — only fill the provider you use
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=
GROQ_API_KEY=
GEMENI_API_KEY=

# Ollama (local, free — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Trading scope ---
# Comma-separated indices to scan/trade. The bot is fully multi-index: each one
# is scanned and can hold its own position concurrently.
ACTIVE_INDICES=NIFTY,BANKNIFTY

# --- Paper budget & risk (all optional; defaults shown) ---
PAPER_CAPITAL=500000            # ₹5L virtual capital
MAX_CAPITAL_PER_TRADE=0.5       # fraction of capital per trade → ₹2.5L at ₹5L
MAX_DAILY_LOSS=-25000           # halt trading for the day past this realized P&L
MAX_PER_TRADE_LOSS=-10000       # per-trade risk budget used for lot sizing
MAX_OPEN_POSITIONS=3
