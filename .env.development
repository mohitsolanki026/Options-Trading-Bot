# ───────────────────────────────────────────────────────────────────────────
#  DEVELOPMENT ENV TEMPLATE  (placeholders only — DO NOT put real secrets here)
#  Copy to `.env` (gitignored) and fill real values, OR run with APP_ENV=development.
#  settings.py loads `.env.${APP_ENV}` first, then `.env`.
# ───────────────────────────────────────────────────────────────────────────

# --- Runtime ---
APP_ENV=development
# Process clock for all market-hours logic. Keep IST for Indian markets.
TZ=Asia/Kolkata

# --- Angel One (broker) ---
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_login_pin
ANGEL_TOTP_SECRET=your_totp_base32_secret

# --- Telegram (alerts) ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- LLM Provider: "anthropic" | "openai" | "groq" | "ollama" | "gemini" ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# API keys — only fill the provider you use
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=
GROQ_API_KEY=
GEMENI_API_KEY=

# Ollama (local, free — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Trading scope ---
# Comma-separated indices to scan/trade, and the primary index.
ACTIVE_INDICES=NIFTY,BANKNIFTY
ACTIVE_INDEX=NIFTY
