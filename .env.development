# ───────────────────────────────────────────────────────────────────────────
#  DEVELOPMENT ENV TEMPLATE  (placeholders only — DO NOT put real secrets here)
#  Copy to `.env` (gitignored) and fill real values, OR run with APP_ENV=development.
#  settings.py loads `.env.${APP_ENV}` first, then `.env`.
# ───────────────────────────────────────────────────────────────────────────

# --- Runtime ---
APP_ENV=development
# Process clock for all market-hours logic. Keep IST for Indian markets.
TZ=Asia/Kolkata

# --- Angel One (broker) ---
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_login_pin
ANGEL_TOTP_SECRET=your_totp_base32_secret

# --- Telegram (alerts) ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- LLM Provider: "anthropic" | "openai" | "groq" | "ollama" | "gemini" ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# API keys — only fill the provider you use
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=
GROQ_API_KEY=
GEMENI_API_KEY=

# Ollama (local, free — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Web dashboard ---
# Loopback by default. The dashboard can close positions, so reach it over
# Tailscale or an HTTPS reverse proxy rather than opening the port.
WEB_UI_ENABLED=1
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8787
# Leave blank and a token is generated once into data/web_token.txt (chmod 600).
WEB_UI_TOKEN=
# "off" disables the login. Only sensible on a private loopback bind.
WEB_UI_AUTH=on

# --- Alerts ---
# Turn Telegram off to keep everything in the dashboard only. Also editable
# from the dashboard's Settings screen.
TELEGRAM_ENABLED=1

# --- Trading scope ---
# Comma-separated indices to scan/trade. The bot is fully multi-index: each one
# is scanned and can hold its own position concurrently.
ACTIVE_INDICES=NIFTY,BANKNIFTY

# --- Paper budget & risk (all optional; defaults shown) ---
PAPER_CAPITAL=500000            # ₹5L virtual capital
MAX_CAPITAL_PER_TRADE=0.5       # fraction of capital per trade → ₹2.5L at ₹5L
MAX_DAILY_LOSS=-25000           # halt trading for the day past this realized P&L
MAX_PER_TRADE_LOSS=-10000       # per-trade risk budget used for lot sizing
MAX_OPEN_POSITIONS=3

# --- Entry-quality controls (all optional; defaults shown) ---
# These are DEFAULTS. Anything changed in the dashboard is saved to
# data/settings.json and wins over the value here.
ENTRY_WINDOW_START=09:40
ENTRY_WINDOW_END=14:00
ENTRY_THRESHOLD=4
IV_RANK_SELL=55
IV_RANK_BUY=30
ENTRY_COOLDOWN_MIN=30           # no re-entry on an index for N min after an exit
MAX_CORRELATED_SHORT=1          # max short-vol positions across a correlated group
EXPIRY_BLACKOUT_DTE=0           # block new entries when days-to-expiry <= this
EVENT_BLACKOUT_DATES=           # ISO dates to skip, e.g. 2026-08-06,2026-09-30
IV_MIN_HISTORY=10               # days of IV history before IV-rank is trusted
MIN_LEG_OI=500                  # skip option legs with OI below this
MIN_CREDIT_PCT=0.004            # min net credit (as % of spot) to sell premium
STRANGLE_TARGET_DELTA=0.16      # delta for short-strangle strike selection
